#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${JUPYTER_NOTEBOOK_PASSWORD:-}" && -z "${JUPYTER_TOKEN:-}" ]]; then
  echo "ERROR: Set JUPYTER_NOTEBOOK_PASSWORD or JUPYTER_TOKEN before starting"
  exit 1
fi

if [[ -n "${JUPYTER_NOTEBOOK_PASSWORD:-}" && ${#JUPYTER_NOTEBOOK_PASSWORD} -lt 12 ]]; then
  echo "ERROR: JUPYTER_NOTEBOOK_PASSWORD must be at least 12 characters"
  exit 1
fi

echo "Starting JupyterLab on Scalingo"

exec jupyter lab \
  --no-browser \
  --ServerApp.ip=0.0.0.0 \
  --ServerApp.port="${PORT:-8888}" \
  --ServerApp.token="${JUPYTER_TOKEN:-}" \
  --config=/app/jupyter_notebook_config.py
